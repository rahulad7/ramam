{
  "expo": {
    "name": "Ramam",
    "slug": "ramam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ramam",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash/ramayana.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf8f7"
    },
    "ios": {
      "bundleIdentifier": "com.ramam.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ramam.app",
      "adaptiveIcon": {
        "backgroundColor": "#fdf8f7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8beedd48-d66d-4c83-a100-132fae14cf0f"
      }
    },
    "owner": "stewied"
  }
}
